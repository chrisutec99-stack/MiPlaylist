@model MiPlaylist.Models.CancionEditarViewModel
@{
    ViewBag.Title = "Editar canción";
}
@Html.Partial("_EstilosFormularios")

<h1 class="h2 mb-1">Editar canción</h1>
<p class="text-body-secondary mb-4">Solo puedes editar las canciones que tú creaste.</p>

@using (Html.BeginForm("Editar", "Catalogo", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

    @Html.Partial("_CamposCancion", Model)

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary px-4">Guardar cambios</button>
        @Html.ActionLink("Cancelar", "Index", "Catalogo", null, new { @class = "btn btn-outline-secondary" })
    </div>
}

@section Scripts { @Scripts.Render("~/bundles/jqueryval") }