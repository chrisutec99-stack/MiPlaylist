@model MiPlaylist.Models.LoginViewModel
@{
    ViewBag.Title = "Iniciar sesión";
}
@Html.Partial("_EstilosFormularios")

<div class="auth-wrap">
    <div class="card auth-card shadow">
        <div class="auth-head">
            <div class="auth-logo">🎵</div>
            <h1 class="h4 mb-1">Bienvenido de vuelta</h1>
            <div class="small opacity-75">Inicia sesión para continuar</div>
        </div>
        <div class="card-body p-4">
            @using (Html.BeginForm("Login", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Correo, new { @class = "form-label" })
                    <div class="input-group">
                        <span class="input-group-text">✉️</span>
                        @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", placeholder = "tucorreo@ejemplo.com", autocomplete = "email", autofocus = "autofocus" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-2">
                    @Html.LabelFor(m => m.Clave, new { @class = "form-label" })
                    <div class="input-group">
                        <span class="input-group-text">🔒</span>
                        @Html.PasswordFor(m => m.Clave, new { @class = "form-control", placeholder = "Tu contraseña", autocomplete = "current-password" })
                        <button class="btn btn-outline-secondary btn-ver" type="button" data-target="Clave" title="Mostrar u ocultar">👁</button>
                    </div>
                    @Html.ValidationMessageFor(m => m.Clave, "", new { @class = "text-danger small" })
                </div>

                <div class="text-end mb-4">
                    @Html.ActionLink("¿Olvidaste tu contraseña?", "OlvideClave", "Account", null, new { @class = "small" })
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">Entrar</button>
            }
        </div>
        <div class="card-footer text-center bg-transparent py-3">
            <span class="text-body-secondary">¿No tienes cuenta?</span>
            @Html.ActionLink("Crear cuenta", "Registro", "Account", null, new { @class = "fw-semibold" })
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        document.querySelectorAll('.btn-ver').forEach(function (b) {
            b.addEventListener('click', function () {
                var i = document.getElementById(b.getAttribute('data-target'));
                i.type = (i.type === 'password') ? 'text' : 'password';
            });
        });
    </script>
}